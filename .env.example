# Copy this file to .env and fill in real values before running the app.

# SQLite by default — good for local dev and small deployments.
# For production at scale, switch to PostgreSQL/MySQL (see README) and
# update the `provider` in prisma/schema.prisma accordingly.
DATABASE_URL="file:./dev.db"

# Random secret used to sign admin/customer login sessions (JWT).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=""

# Used only once, by the seed script (npm run db:seed), to create the
# first admin account. Change the password after first login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# Public base URL of the site (used for metadata, sitemap, absolute links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Store contact details used as a fallback until an admin fills in
# Settings from the admin panel.
NEXT_PUBLIC_STORE_NAME="AutoSpare Parts"
NEXT_PUBLIC_STORE_PHONE="+91 90000 00000"
NEXT_PUBLIC_STORE_WHATSAPP="+91 90000 00000"
NEXT_PUBLIC_STORE_EMAIL="contact@example.com"
NEXT_PUBLIC_STORE_ADDRESS="123 Main Road, Your City, State, 000000"

# --- Order notifications ---
# Shop owner's phone: receives a WhatsApp message with the full details of
# every new order (10-digit Indian mobile number, no +91 needed).
ADMIN_NOTIFY_PHONE="9894705498"

# --- WhatsApp (order details to customer + shop owner) ---
# Leave WHATSAPP_PROVIDER blank to skip sending — messages are printed to
# the server console instead, and checkout still works normally. The admin
# panel's "Send on WhatsApp" buttons work with no setup either way.
#
#   "meta"    → WhatsApp Cloud API (developers.facebook.com/docs/whatsapp)
#   "twilio"  → Twilio WhatsApp (easiest to test, has a sandbox)
#   "webhook" → POST { to, message } to your own endpoint, for Indian BSPs
#               like AiSensy / Interakt / Gupshup / Wati
WHATSAPP_PROVIDER=""

# Required when WHATSAPP_PROVIDER="meta"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Optional: WhatsApp requires an approved template to message someone who
# hasn't messaged you in the last 24h. Set the approved template name here;
# the order summary is passed as its first body parameter.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="en"

# Required when WHATSAPP_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Required when WHATSAPP_PROVIDER="webhook"
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_AUTH_HEADER=""

# --- SMS (optional, in addition to WhatsApp) ---
# Leave blank to disable. "twilio" or "webhook".
SMS_PROVIDER=""
TWILIO_FROM_NUMBER=""
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_AUTH_HEADER=""
