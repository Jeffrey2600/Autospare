# Copy this file to .env and fill in real values before running the app.

# SQLite by default — good for local dev and small deployments.
# For production at scale, switch to PostgreSQL/MySQL (see README) and
# update the `provider` in prisma/schema.prisma accordingly.
DATABASE_URL="file:./dev.db"

# Random secret used to sign admin/customer login sessions (JWT).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=""

# Used only once, by the seed script (npm run db:seed), to create the
# first admin account. Change the password after first login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# Public base URL of the site (used for metadata, sitemap, absolute links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Store contact details used as a fallback until an admin fills in
# Settings from the admin panel.
NEXT_PUBLIC_STORE_NAME="AutoSpare Parts"
NEXT_PUBLIC_STORE_PHONE="+91 90000 00000"
NEXT_PUBLIC_STORE_WHATSAPP="+91 90000 00000"
NEXT_PUBLIC_STORE_EMAIL="contact@example.com"
NEXT_PUBLIC_STORE_ADDRESS="123 Main Road, Your City, State, 000000"

# --- Order SMS notifications (optional) ---
# When a customer places an order, a confirmation SMS is sent to them and
# a notification SMS is sent to the shop's phone. Leave SMS_PROVIDER unset
# to skip sending (the message is only logged to the server console) —
# useful for local development or until you sign up with a provider.
#
# Phone number that receives "new order" SMS alerts (10-digit Indian
# mobile number, no +91 needed).
ADMIN_NOTIFY_PHONE="9894705498"

# Set to "twilio" to send via Twilio (https://www.twilio.com/console), or
# "webhook" to POST { to, message } as JSON to your own SMS_WEBHOOK_URL
# (e.g. a serverless function that calls MSG91/Fast2SMS/TextLocal/etc).
# Leave blank to disable sending.
SMS_PROVIDER=""

# Required when SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Required when SMS_PROVIDER="webhook"
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_AUTH_HEADER=""
